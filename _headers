# Cloudflare Pages читает этот файл и отдаёт заголовки без пересборки.
# Правила складываются: подходящие блоки применяются все сразу, а не
# только самый точный. Поэтому Cache-Control задаётся ровно в одном
# месте — иначе заголовок склеивается из двух значений.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Страницам Cloudflare сам ставит max-age=0, must-revalidate — это то,
# что нужно: адреса у них постоянные, содержимое меняется.
#
# Картинки, стили и скрипт держатся час, дальше обновляются в фоне.
# Дольше нельзя: в именах файлов нет отпечатка содержимого, и замена
# под тем же именем не дошла бы до вернувшихся посетителей.
/img/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/styles.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/app.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
